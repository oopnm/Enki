# Maintainer: Ahmed Al-Iraqi <ahmed@local>
pkgname=enki
pkgver=0.1.0
pkgrel=1
pkgdesc="Use your phone as a webcam, microphone and screen source on Linux"
arch=('x86_64')
url="https://github.com/oopnm/Enki"
license=('GPL3')
depends=('gtk4' 'scrcpy' 'v4l2loopback-dkms' 'v4l-utils' 'polkit')
makedepends=('cargo' 'rust')
# ملاحظة: شغّل makepkg من مجلد منفصل (وليس من جذر الريبو) لأن makepkg
# يستخدم مجلد src/ لفك المصدر.
source=("$pkgname-$pkgver.tar.gz::$url/archive/refs/tags/v$pkgver.tar.gz")
sha256sums=('SKIP')

build() {
    cd "$srcdir"/*-$pkgver
    export RUSTUP_TOOLCHAIN=stable
    cargo build --release --locked -p enki-gui
}

package() {
    cd "$srcdir"/*-$pkgver
    install -Dm755 target/release/enki "$pkgdir/usr/bin/enki"
    install -Dm644 packaging/appimage/enki.desktop "$pkgdir/usr/share/applications/enki.desktop"
    install -Dm644 packaging/appimage/enki.png "$pkgdir/usr/share/icons/hicolor/256x256/apps/enki.png"
    install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
