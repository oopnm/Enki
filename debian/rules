#!/usr/bin/make -f
%:
	dh $@

override_dh_auto_clean:

override_dh_auto_build:
	cargo build --release --locked -p enki-gui

override_dh_auto_test:

override_dh_auto_install:
	install -Dm755 target/release/enki debian/enki/usr/bin/enki
	install -Dm644 packaging/appimage/enki.desktop debian/enki/usr/share/applications/enki.desktop
	install -Dm644 packaging/appimage/enki.png debian/enki/usr/share/icons/hicolor/256x256/apps/enki.png
